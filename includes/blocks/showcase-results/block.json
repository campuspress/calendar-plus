{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "calendar-plus/showcase-results",
  "version": "2.2.25",
  "title": "Events Showcase Results",
  "description": "Filter real Calendar Plus occurrences and edit the shared event card templates.",
  "category": "widgets",
  "icon": "calendar-alt",
  "textdomain": "calendar-plus",
  "attributes": {
    "view": {
      "type": "string",
      "default": "upcoming"
    },
    "from": {
      "type": "string",
      "default": ""
    },
    "to": {
      "type": "string",
      "default": ""
    },
    "category": {
      "type": "string",
      "default": ""
    },
    "tag": {
      "type": "string",
      "default": ""
    },
    "search": {
      "type": "string",
      "default": ""
    },
    "order": {
      "type": "string",
      "default": ""
    },
    "layout": {
      "type": "string",
      "default": "grid"
    },
    "navigationId": {
      "type": "string",
      "default": ""
    },
    "previewContent": {
      "type": "string",
      "default": ""
    },
    "perPage": {
      "type": "number",
      "default": 6
    },
    "columns": {
      "type": "number",
      "default": 3
    },
    "gap": {
      "type": "number",
      "default": 20
    },
    "showFeatured": {
      "type": "boolean",
      "default": true
    },
    "featuredId": {
      "type": "number",
      "default": 0
    },
    "pastFallback": {
      "type": "boolean",
      "default": true
    },
    "previewPostId": {
      "type": "number",
      "default": 0
    },
    "previewPostType": {
      "type": "string",
      "default": "calendar_event"
    }
  },
  "supports": {
    "html": false,
    "color": {
      "text": true,
      "background": true,
      "link": true,
      "gradients": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "textAlign": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalLetterSpacing": true,
      "__experimentalTextTransform": true,
      "__experimentalTextDecoration": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "editorScript": "calendarp-showcase-editor",
  "style": "calendarp-showcase",
  "render": "file:./render.php",
  "providesContext": {
    "postId": "previewPostId",
    "postType": "previewPostType"
  },
  "usesContext": [
    "postId",
    "postType"
  ]
}
