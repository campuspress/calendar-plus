{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "calendar-plus/events-showcase",
  "version": "2.2.25",
  "title": "Events Showcase",
  "description": "An editable events page with a hero, filters, featured event and grid or list cards.",
  "category": "widgets",
  "icon": "calendar-alt",
  "textdomain": "calendar-plus",
  "attributes": {
    "palette": {
      "type": "object",
      "default": {}
    }
  },
  "supports": {
    "html": false,
    "color": {
      "text": true,
      "background": true,
      "link": true,
      "gradients": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "textAlign": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalLetterSpacing": true,
      "__experimentalTextTransform": true,
      "__experimentalTextDecoration": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true,
    "align": [
      "wide",
      "full"
    ],
    "anchor": true
  },
  "editorScript": "calendarp-showcase-editor",
  "style": "calendarp-showcase",
  "render": "file:./render.php"
}
